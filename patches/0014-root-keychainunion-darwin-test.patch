+// Restores, for the keychain union, the darwin coverage patch 0018 removed from upstream's
+// TestHybridPool when it made that test skip on darwin (upstream's TestHybridPool assumes Apple's
+// verifier is the default, which go127 deliberately does not have -- PORT.md). SystemCertPool
+// returns a copy of the cached systemRootsPool (keychainUnionFakeKeychain resets it); adding a
+// certificate to that copy must leave both the keychain's own anchor and the added one able to
+// verify.
+func TestKeychainUnionSystemCertPoolAddCertKeepsBoth(t *testing.T) {
+	kRoot, kLeaf := keychainUnionTestChain(t)
+	aRoot, aLeaf := keychainUnionTestChain(t)
+	keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+	empty := filepath.Join(t.TempDir(), "empty.pem")
+	if err := os.WriteFile(empty, nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	keychainUnionEnv(t, "", empty, "")
+
+	p, err := SystemCertPool()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.AddCert(aRoot)
+
+	keychainUnionMustVerify(t, p, kLeaf, "keychain root missing from SystemCertPool's copy after AddCert")
+	keychainUnionMustVerify(t, p, aLeaf, "AddCert's own root missing after SystemCertPool")
+}
