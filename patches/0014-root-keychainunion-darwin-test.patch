Darwin tests for the keychain-union trust model: SetFallbackRoots neither panics
nor displaces the union (unless GODEBUG=x509usefallbackroots=1, as upstream);
GODEBUG=x509usefallbackroots=0 selects Apple's verifier; and Apple's verifier,
driven through the calls that exist on older macOS, maps its results to Go's
typed errors and returns the chain. Those Apple-verifier tests skip only when an
independent probe -- the non-forced systemVerify on the fixture -- says the
host's keychain doesn't trust it; once it does, any error from the path under
test fails. On 10.15+ (CI) that probe runs the modern calls, so a broken
legacy path fails rather than skips; below 10.15 the probe is legacy too, and
the on-box acceptance script is the gate.

It also pins go127's loadSystemRoots table: SSL_CERT_* shapes the union and
keeps the keychain and the veto, x509sslcertoverrideplatform has no effect,
x509usefallbackroots=0 wins, a missing SSL_CERT_FILE keeps the keychain, and
an empty union is an error.

--- src/crypto/x509/root_keychainunion_darwin_test.go.orig
+++ src/crypto/x509/root_keychainunion_darwin_test.go
@@ -0,0 +1,475 @@
+//go:build darwin
+
+package x509
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+)
+
+// keychainUnionFallbacksSetAtInit records fallbacksSet as every package init left it. Internal
+// test files compile after the package's own files, so this init runs after all of those. The
+// old darwin init claimed fallbacksSet, which made any program's SetFallbackRoots panic.
+var keychainUnionFallbacksSetAtInit bool
+
+func init() { keychainUnionFallbacksSetAtInit = fallbacksSet }
+
+// keychainUnionResetSystemRoots gives a test a fresh, not-yet-loaded system-roots state,
+// and leaves a fresh one behind so later tests load lazily again.
+func keychainUnionResetSystemRoots(t *testing.T) {
+	t.Helper()
+	savedDistrust := keychainUnionDistrusted
+	reset := func() {
+		systemRootsMu.Lock()
+		defer systemRootsMu.Unlock()
+		once = sync.Once{}
+		systemRoots, systemRootsErr = nil, nil
+		fallbacksSet, useFallbackRoots = false, false
+	}
+	reset()
+	t.Cleanup(func() {
+		reset()
+		keychainUnionDistrusted = savedDistrust
+	})
+}
+
+// A program importing golang.org/x/crypto/x509roots/fallback calls SetFallbackRoots from
+// its init. It must not panic, and -- as upstream, with the union as the system roots --
+// must not replace the union unless GODEBUG=x509usefallbackroots=1.
+func TestKeychainUnionSetFallbackRootsDoesNotPanic(t *testing.T) {
+	t.Setenv("GODEBUG", "")
+	if keychainUnionFallbacksSetAtInit {
+		t.Fatal("a package init claimed fallbacksSet: any program's SetFallbackRoots would panic")
+	}
+
+	keychainUnionResetSystemRoots(t)
+	fallback := NewCertPool()
+	SetFallbackRoots(fallback)
+	pool := systemRootsPool()
+	if pool == fallback {
+		t.Fatal("the program's fallback pool replaced the keychain union without GODEBUG=x509usefallbackroots=1")
+	}
+	if pool == nil || pool.systemPool || pool.len() == 0 {
+		t.Fatalf("system roots are not the keychain union (nil=%v systemPool=%v)", pool == nil, pool != nil && pool.systemPool)
+	}
+}
+
+func TestKeychainUnionForcedFallbackReplacesUnion(t *testing.T) {
+	keychainUnionResetSystemRoots(t)
+	t.Setenv("GODEBUG", "x509usefallbackroots=1")
+	fallback := NewCertPool()
+	SetFallbackRoots(fallback)
+	if pool := systemRootsPool(); pool != fallback {
+		t.Fatal("GODEBUG=x509usefallbackroots=1 + SetFallbackRoots should use the program's pool, as upstream")
+	}
+}
+
+func TestKeychainUnionNativeOptOut(t *testing.T) {
+	saved := keychainUnionDistrusted
+	t.Cleanup(func() { keychainUnionDistrusted = saved })
+	t.Setenv("GODEBUG", "")
+	if pool, err := loadSystemRoots(); err != nil || pool == nil || pool.systemPool {
+		t.Fatalf("default: want the keychain union, got nil=%v err=%v", pool == nil, err)
+	}
+	t.Setenv("GODEBUG", "x509usefallbackroots=0")
+	if pool, err := loadSystemRoots(); err != nil || pool == nil || !pool.systemPool {
+		t.Fatalf("GODEBUG=x509usefallbackroots=0: want the systemPool marker, got nil=%v err=%v", pool == nil, err)
+	}
+}
+
+func keychainUnionForceLegacy(t *testing.T) {
+	t.Helper()
+	keychainUnionForceLegacySecTrust = true
+	t.Cleanup(func() { keychainUnionForceLegacySecTrust = false })
+}
+
+// keychainUnionSelfSignedServer returns a self-signed TLS server certificate for name.
+func keychainUnionSelfSignedServer(t *testing.T, name string) *Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &Certificate{
+		SerialNumber:          big.NewInt(42),
+		Subject:               pkix.Name{CommonName: name},
+		DNSNames:              []string{name},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		KeyUsage:              KeyUsageDigitalSignature,
+		ExtKeyUsage:           []ExtKeyUsage{ExtKeyUsageServerAuth},
+		BasicConstraintsValid: true,
+	}
+	der, err := CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cert
+}
+
+func TestKeychainUnionLegacySecTrustRejectsUntrusted(t *testing.T) {
+	keychainUnionForceLegacy(t)
+	cert := keychainUnionSelfSignedServer(t, "legacy.keychainunion.test")
+	_, err := cert.systemVerify(&VerifyOptions{DNSName: "legacy.keychainunion.test", CurrentTime: time.Now()})
+	if _, ok := err.(UnknownAuthorityError); !ok {
+		t.Fatalf("got %v (%T), want UnknownAuthorityError", err, err)
+	}
+}
+
+// keychainUnionFixture returns the captured leaf and a pool of the rest of its chain.
+func keychainUnionFixture(t *testing.T) (*Certificate, *CertPool) {
+	t.Helper()
+	data, err := os.ReadFile("testdata/keychainunion-isrgrootx1-chain.pem")
+	if err != nil {
+		t.Fatal(err)
+	}
+	certs := keychainUnionParseBundle(data)
+	if len(certs) < 2 || len(certs[0].DNSNames) == 0 {
+		t.Fatalf("fixture: want a leaf with a DNS name plus its chain, got %d certificates", len(certs))
+	}
+	inters := NewCertPool()
+	for _, c := range certs[1:] {
+		inters.AddCert(c)
+	}
+	return certs[0], inters
+}
+
+// keychainUnionHostTrustsFixture reports whether this host's Apple verifier accepts the
+// fixture at a time inside its validity, probed through the NON-forced systemVerify. It is
+// the only reason a legacy-path test may skip: once the host trusts the fixture, any error
+// from the path under test is a failure, so a broken legacy path cannot pass as a skip.
+//
+// On macOS 10.15+ (CI) the non-forced path is the modern API, so this probe is independent
+// of the legacy code. Below 10.15 the non-forced path is the legacy one too, so a broken
+// legacy path would skip here; on those hosts the on-box acceptance script
+// (tests/trust/acceptance-onbox.sh) is the gate.
+func keychainUnionHostTrustsFixture(t *testing.T) bool {
+	t.Helper()
+	saved := keychainUnionForceLegacySecTrust
+	keychainUnionForceLegacySecTrust = false
+	defer func() { keychainUnionForceLegacySecTrust = saved }()
+	leaf, inters := keychainUnionFixture(t)
+	opts := &VerifyOptions{DNSName: leaf.DNSNames[0], Intermediates: inters, CurrentTime: leaf.NotBefore.Add(24 * time.Hour)}
+	if _, err := leaf.systemVerify(opts); err != nil {
+		t.Logf("probe: this host's Apple verifier does not accept the fixture: %v", err)
+		return false
+	}
+	return true
+}
+
+// Apple's verifier, through the older-macOS calls (forced) and through whatever this macOS
+// selects (auto). Skips only when keychainUnionHostTrustsFixture says the host doesn't trust
+// the fixture's root (ISRG Root X1).
+func TestKeychainUnionSystemVerifyVerifiesChain(t *testing.T) {
+	for _, legacy := range []bool{true, false} {
+		name := map[bool]string{true: "legacy", false: "auto"}[legacy]
+		t.Run(name, func(t *testing.T) {
+			if !keychainUnionHostTrustsFixture(t) {
+				t.Skip("this host's keychain does not trust the fixture's root")
+			}
+			if legacy {
+				keychainUnionForceLegacy(t)
+			}
+			leaf, inters := keychainUnionFixture(t)
+			opts := &VerifyOptions{DNSName: leaf.DNSNames[0], Intermediates: inters, CurrentTime: leaf.NotBefore.Add(24 * time.Hour)}
+			chains, err := leaf.systemVerify(opts)
+			if err != nil {
+				t.Fatalf("the host trusts the fixture, but systemVerify failed: %v", err)
+			}
+			if len(chains) != 1 || len(chains[0]) < 2 || !chains[0][0].Equal(leaf) {
+				t.Fatalf("unexpected chains: %v", chains)
+			}
+		})
+	}
+}
+
+func TestKeychainUnionLegacySecTrustTypedErrors(t *testing.T) {
+	if !keychainUnionHostTrustsFixture(t) {
+		t.Skip("this host's keychain does not trust the fixture's root")
+	}
+	keychainUnionForceLegacy(t)
+	leaf, inters := keychainUnionFixture(t)
+	inside := leaf.NotBefore.Add(24 * time.Hour)
+	if _, err := leaf.systemVerify(&VerifyOptions{DNSName: leaf.DNSNames[0], Intermediates: inters, CurrentTime: inside}); err != nil {
+		t.Fatalf("the host trusts the fixture, but the legacy path failed on it: %v", err)
+	}
+	_, err := leaf.systemVerify(&VerifyOptions{DNSName: "wrong.keychainunion.test", Intermediates: inters, CurrentTime: inside})
+	if _, ok := err.(HostnameError); !ok {
+		t.Errorf("wrong host: got %v (%T), want HostnameError", err, err)
+	}
+	_, err = leaf.systemVerify(&VerifyOptions{DNSName: leaf.DNSNames[0], Intermediates: inters, CurrentTime: leaf.NotAfter.Add(48 * time.Hour)})
+	if e, ok := err.(CertificateInvalidError); !ok || e.Reason != Expired {
+		t.Errorf("expired: got %v (%T), want CertificateInvalidError{Reason: Expired}", err, err)
+	}
+}
+
+// keychainUnionFakeKeychain makes the union see entries instead of the host's keychain, so a test
+// controls exactly what is trusted and distrusted. Also resets the cached systemRoots pool: on
+// darwin, Verify consults systemRootsPool() even when Roots is set (verify.go ~568), so a test that
+// calls Verify would otherwise leave its fake keychain and env cached in systemRoots for the rest of
+// the process -- and, symmetrically, could itself see a stale pool an earlier test left cached.
+// Restores the enumerator and the distrust set.
+func keychainUnionFakeKeychain(t *testing.T, entries ...keychainUnionTrustEntry) {
+	t.Helper()
+	keychainUnionResetSystemRoots(t)
+	savedEnum, savedDistrust := keychainUnionEnumerate, keychainUnionDistrusted
+	keychainUnionEnumerate = func() []keychainUnionTrustEntry { return entries }
+	t.Cleanup(func() { keychainUnionEnumerate, keychainUnionDistrusted = savedEnum, savedDistrust })
+}
+
+// keychainUnionWriteBundle writes certs as one PEM bundle in a temp dir and returns its path.
+func keychainUnionWriteBundle(t *testing.T, certs ...*Certificate) string {
+	t.Helper()
+	var b []byte
+	for _, c := range certs {
+		b = append(b, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: c.Raw})...)
+	}
+	p := filepath.Join(t.TempDir(), "bundle.pem")
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// keychainUnionWriteBundleDir writes certs as one PEM bundle file inside a fresh temp dir and
+// returns the dir, for a test exercising SSL_CERT_DIR (which reads every entry in the directory).
+func keychainUnionWriteBundleDir(t *testing.T, certs ...*Certificate) string {
+	t.Helper()
+	return filepath.Dir(keychainUnionWriteBundle(t, certs...))
+}
+
+// keychainUnionEnv sets GODEBUG, SSL_CERT_FILE and SSL_CERT_DIR for one test.
+func keychainUnionEnv(t *testing.T, godebug, certFile, certDir string) {
+	t.Helper()
+	t.Setenv("GODEBUG", godebug)
+	t.Setenv("SSL_CERT_FILE", certFile)
+	t.Setenv("SSL_CERT_DIR", certDir)
+}
+
+func keychainUnionMustVerify(t *testing.T, pool *CertPool, leaf *Certificate, why string) {
+	t.Helper()
+	if _, err := leaf.Verify(VerifyOptions{Roots: pool, CurrentTime: time.Now()}); err != nil {
+		t.Errorf("%s: %v", why, err)
+	}
+}
+
+// Table rows "SSL_CERT_* set, x509usefallbackroots not 0": the env shapes the union's bundle files
+// and the keychain stays in. Upstream Go 1.27 makes SSL_CERT_* exclusive on darwin (no keychain);
+// go127 deliberately keeps go126's keychain-preserving semantics (PORT.md, spec decision 5). Covers
+// both SSL_CERT_FILE and SSL_CERT_DIR.
+func TestKeychainUnionEnvUnionsWithKeychain(t *testing.T) {
+	t.Run("SSL_CERT_FILE", func(t *testing.T) {
+		kRoot, kLeaf := keychainUnionTestChain(t)
+		eRoot, eLeaf := keychainUnionTestChain(t)
+		keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+		keychainUnionEnv(t, "", keychainUnionWriteBundle(t, eRoot), "")
+		pool, err := loadSystemRoots()
+		if err != nil || pool == nil || pool.systemPool {
+			t.Fatalf("SSL_CERT_FILE set: want the keychain union, got nil=%v systemPool=%v err=%v", pool == nil, pool != nil && pool.systemPool, err)
+		}
+		keychainUnionMustVerify(t, pool, kLeaf, "keychain root dropped while SSL_CERT_FILE is set -- go127 keeps the keychain in the union (upstream 1.27 drops it; PORT.md)")
+		keychainUnionMustVerify(t, pool, eLeaf, "SSL_CERT_FILE's root is missing from the union")
+	})
+
+	t.Run("SSL_CERT_DIR", func(t *testing.T) {
+		kRoot, kLeaf := keychainUnionTestChain(t)
+		dRoot, dLeaf := keychainUnionTestChain(t)
+		eRoot, eLeaf := keychainUnionTestChain(t)
+		keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+		keychainUnionEnv(t, "", "", keychainUnionWriteBundleDir(t, dRoot, eRoot))
+		pool, err := loadSystemRoots()
+		if err != nil || pool == nil || pool.systemPool {
+			t.Fatalf("SSL_CERT_DIR set: want the keychain union, got nil=%v systemPool=%v err=%v", pool == nil, pool != nil && pool.systemPool, err)
+		}
+		keychainUnionMustVerify(t, pool, kLeaf, "keychain root dropped while SSL_CERT_DIR is set")
+		keychainUnionMustVerify(t, pool, dLeaf, "SSL_CERT_DIR's bundle is missing dRoot from the union")
+		keychainUnionMustVerify(t, pool, eLeaf, "SSL_CERT_DIR's bundle is missing eRoot from the union")
+	})
+}
+
+// A keychain Deny must veto even when SSL_CERT_FILE names a bundle holding that very root: a user's
+// Never Trust must not stop applying because a Python/conda env or a shell rc set SSL_CERT_FILE.
+func TestKeychainUnionEnvKeepsDistrustVeto(t *testing.T) {
+	dRoot, dLeaf := keychainUnionTestChain(t)
+	oRoot, _ := keychainUnionTestChain(t)
+	keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: dRoot.Raw, result: keychainUnionTrustDeny})
+	keychainUnionEnv(t, "", keychainUnionWriteBundle(t, dRoot, oRoot), "")
+	pool, err := loadSystemRoots()
+	if err != nil || pool == nil || pool.systemPool {
+		t.Fatalf("want the keychain union, got nil=%v systemPool=%v err=%v", pool == nil, pool != nil && pool.systemPool, err)
+	}
+	if pool.contains(dRoot) {
+		t.Fatal("a keychain-distrusted root from SSL_CERT_FILE is in the anchor pool -- distrust must subtract bundle roots too")
+	}
+	explicit := NewCertPool()
+	explicit.AddCert(dRoot)
+	if _, err := dLeaf.Verify(VerifyOptions{Roots: explicit, CurrentTime: time.Now()}); err == nil {
+		t.Fatal("the distrust veto did not reject a chain through a keychain-denied root while SSL_CERT_FILE was set")
+	}
+}
+
+// x509sslcertoverrideplatform has NO effect on darwin. Upstream registers it Changed: 27, Old: "0",
+// so every program whose go.mod says go 1.26 or lower gets =0 by default; "=0 = pre-1.27 behaviour",
+// and for this toolchain that is go126's -- the env still shapes the union (PORT.md, spec decision 5).
+func TestKeychainUnionOverridePlatformHasNoEffect(t *testing.T) {
+	kRoot, kLeaf := keychainUnionTestChain(t)
+	eRoot, eLeaf := keychainUnionTestChain(t)
+	keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+	bundle := keychainUnionWriteBundle(t, eRoot)
+	for _, godebug := range []string{"x509sslcertoverrideplatform=0", "x509sslcertoverrideplatform=1"} {
+		t.Run(godebug, func(t *testing.T) {
+			keychainUnionEnv(t, godebug, bundle, "")
+			pool, err := loadSystemRoots()
+			if err != nil || pool == nil || pool.systemPool {
+				t.Fatalf("%s: want the keychain union, got nil=%v systemPool=%v err=%v", godebug, pool == nil, pool != nil && pool.systemPool, err)
+			}
+			keychainUnionMustVerify(t, pool, kLeaf, godebug+": keychain root missing")
+			keychainUnionMustVerify(t, pool, eLeaf, godebug+": SSL_CERT_FILE ignored -- a go.mod at go 1.26 would silently stop honouring it under go127")
+		})
+	}
+}
+
+// Table rows with x509usefallbackroots=0: Apple's verifier (the systemPool marker), whatever the env
+// and whatever x509sslcertoverrideplatform says.
+func TestKeychainUnionNativeOptOutWinsOverEnv(t *testing.T) {
+	eRoot, _ := keychainUnionTestChain(t)
+	bundle := keychainUnionWriteBundle(t, eRoot)
+	for _, tc := range []struct{ name, godebug, file string }{
+		{"no env", "x509usefallbackroots=0", ""},
+		{"env", "x509usefallbackroots=0", bundle},
+		{"env, override=0", "x509usefallbackroots=0,x509sslcertoverrideplatform=0", bundle},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			keychainUnionEnv(t, tc.godebug, tc.file, "")
+			pool, err := loadSystemRoots()
+			if err != nil || pool == nil || !pool.systemPool {
+				t.Fatalf("%s: want the systemPool marker (Apple's verifier), got nil=%v systemPool=%v err=%v", tc.name, pool == nil, pool != nil && pool.systemPool, err)
+			}
+		})
+	}
+}
