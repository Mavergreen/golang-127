+// A stale SSL_CERT_FILE path (a deleted venv, say) is not an error while the keychain has anchors:
+// go126 served the keychain alone, and so must go127.
+func TestKeychainUnionMissingEnvFileKeepsKeychain(t *testing.T) {
+	kRoot, kLeaf := keychainUnionTestChain(t)
+	keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+	keychainUnionEnv(t, "", filepath.Join(t.TempDir(), "does-not-exist.pem"), "")
+	pool, err := loadSystemRoots()
+	if err != nil || pool == nil || pool.systemPool {
+		t.Fatalf("missing SSL_CERT_FILE: want the keychain union and no error, got nil=%v err=%v", pool == nil, err)
+	}
+	keychainUnionMustVerify(t, pool, kLeaf, "keychain root missing when SSL_CERT_FILE names a missing file")
+}
+
+// Nothing to trust at all is an error, so Verify with nil Roots falls back to Apple's verifier
+// and SystemCertPool reports it -- go126's empty-union behaviour.
+func TestKeychainUnionEmptyUnionIsAnError(t *testing.T) {
+	keychainUnionFakeKeychain(t)
+	empty := filepath.Join(t.TempDir(), "empty.pem")
+	if err := os.WriteFile(empty, nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	keychainUnionEnv(t, "", empty, "")
+	if pool, err := loadSystemRoots(); err == nil {
+		t.Fatalf("empty keychain + empty bundle: want an error, got a pool of %d", pool.len())
+	}
+}
+
+// The other half of invariant 6: TestKeychainUnionEmptyUnionIsAnError only pins
+// loadSystemRoots's own error. Verify itself must still produce a real verification result for an
+// empty union, not surface "no system roots": on darwin, Verify's platform-verifier branch calls
+// systemVerify whenever Roots is nil and the system pool is nil or the systemPool marker --
+// checked before Verify ever looks at systemRootsPool() for nil (verify.go) -- so an empty union
+// (systemRootsPool() == nil) falls through to Apple's verifier exactly like the systemPool marker
+// does, never to SystemRootsError.
+func TestKeychainUnionEmptyUnionFallsBackToAppleVerifier(t *testing.T) {
+	keychainUnionFakeKeychain(t)
+	empty := filepath.Join(t.TempDir(), "empty.pem")
+	if err := os.WriteFile(empty, nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	keychainUnionEnv(t, "", empty, "")
+
+	leaf := keychainUnionSelfSignedServer(t, "example.test")
+	_, err := leaf.Verify(VerifyOptions{})
+	if err == nil {
+		t.Fatal("empty union: want an error verifying an untrusted self-signed leaf, got nil")
+	}
+	if _, ok := err.(SystemRootsError); ok {
+		t.Fatalf("got SystemRootsError -- an empty union must still fall back to Apple's verifier (systemVerify), not report \"no system roots\": %v", err)
+	}
+	// Observed on this host (a modern Mac, the non-legacy SecTrust path): Apple's verifier maps
+	// an untrusted self-signed leaf to macos.ErrSecNotTrusted, which systemVerify's
+	// SecTrustEvaluateWithError switch turns into UnknownAuthorityError (root_darwin.go). The
+	// legacy SecTrust path (macOS < 10.15) returns the same type for a Deny result
+	// (keychainUnionLegacyEvaluate's SecTrustResultDeny case), so this assertion holds either way.
+	if _, ok := err.(UnknownAuthorityError); !ok {
+		t.Fatalf("got %v (%T), want UnknownAuthorityError -- proves systemVerify (Apple's) ran instead of reporting \"no system roots\"", err, err)
+	}
+}
+
+// A program importing golang.org/x/crypto/x509roots/fallback calls SetFallbackRoots from init. With
+// SSL_CERT_FILE set it must still get the union, not its fallback pool, unless x509usefallbackroots=1.
+func TestKeychainUnionEnvWithSetFallbackRoots(t *testing.T) {
+	kRoot, _ := keychainUnionTestChain(t)
+	eRoot, _ := keychainUnionTestChain(t)
+	keychainUnionFakeKeychain(t, keychainUnionTrustEntry{der: kRoot.Raw, result: keychainUnionTrustRoot})
+	keychainUnionEnv(t, "", keychainUnionWriteBundle(t, eRoot), "")
+	keychainUnionResetSystemRoots(t)
+	fallback := NewCertPool()
+	SetFallbackRoots(fallback)
+	pool := systemRootsPool()
+	if pool == fallback || pool == nil || pool.systemPool || !pool.contains(kRoot) || !pool.contains(eRoot) {
+		t.Fatalf("SSL_CERT_FILE + SetFallbackRoots: want the keychain union with both the keychain root and the bundle root (fallback=%v nil=%v)", pool == fallback, pool == nil)
+	}
+}
+
+// The line-independent bundle the ca-certs product will install: any Go line, and any program
+// cross-built for a box with no Go installed, finds one maintained bundle there (spec decision 6).
+func TestKeychainUnionCaCertsBundleListed(t *testing.T) {
+	const want = "/usr/local/mavergreen/ca-certs/etc/openssl/certs/ca-certificates.crt"
+	if !slices.Contains(keychainUnionBundlePaths, want) {
+		t.Fatalf("keychainUnionBundlePaths lacks %s: %v", want, keychainUnionBundlePaths)
+	}
+}
