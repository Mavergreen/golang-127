The !darwin half of keychainUnionPlatformRoots: returns handled=false so the
root.go hook (patch 0016) is inert and upstream's loadSystemRoots runs on every
platform but darwin. Without it, crypto/x509 does not compile for GOOS=linux or
windows.

--- src/crypto/x509/root_keychainunion_other.go.orig
+++ src/crypto/x509/root_keychainunion_other.go
@@ -0,0 +1,12 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build !darwin
+
+package x509
+
+// keychainUnionPlatformRoots leaves loadSystemRoots to upstream on every platform but darwin.
+func keychainUnionPlatformRoots() (*CertPool, bool, error) {
+	return nil, false, nil
+}
